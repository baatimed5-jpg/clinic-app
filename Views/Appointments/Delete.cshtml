@model ClinicApp.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="page-head">
    <h1>Delete Appointment</h1>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

<div class="alert alert-warning">Are you sure you want to delete this appointment?</div>

<div class="panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Patient)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Patient.FullName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Doctor)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Doctor.FullName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AppointmentDate)</dt>
        <dd class="col-sm-9">@Model.AppointmentDate.ToString("yyyy-MM-dd HH:mm")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Reason)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Reason)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Status)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Notes)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Notes)</dd>
    </dl>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="AppointmentId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
