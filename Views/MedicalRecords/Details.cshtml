@model ClinicApp.Models.MedicalRecord

@{
    ViewData["Title"] = "Medical Record Details";
}

<div class="page-head">
    <h1>Medical Record</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model?.RecordId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<div class="panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Patient)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Patient.FullName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Doctor)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Doctor.FullName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.VisitDate)</dt>
        <dd class="col-sm-9">@Model.VisitDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Diagnosis)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Diagnosis)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Prescription)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Prescription)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Notes)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Notes)</dd>
    </dl>
</div>
