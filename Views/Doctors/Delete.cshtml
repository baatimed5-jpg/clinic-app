@model ClinicApp.Models.Doctor

@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="page-head">
    <h1>Delete Doctor</h1>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

<div class="alert alert-warning">Are you sure you want to delete this doctor?</div>

<div class="panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FullName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.FullName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Specialization)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Specialization)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Phone)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Phone)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsAvailable)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.IsAvailable)</dd>
    </dl>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="DoctorId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
