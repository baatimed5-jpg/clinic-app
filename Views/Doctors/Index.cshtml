@model IEnumerable<ClinicApp.Models.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<div class="page-head">
    <h1>Doctors</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Doctor</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FullName)</th>
            <th>@Html.DisplayNameFor(model => model.Specialization)</th>
            <th>@Html.DisplayNameFor(model => model.Phone)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>@Html.DisplayNameFor(model => model.IsAvailable)</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.FullName)</td>
            <td>@Html.DisplayFor(modelItem => item.Specialization)</td>
            <td>@Html.DisplayFor(modelItem => item.Phone)</td>
            <td>@Html.DisplayFor(modelItem => item.Email)</td>
            <td>
                @if (item.IsAvailable)
                {
                    <span class="badge bg-success">Available</span>
                }
                else
                {
                    <span class="badge bg-secondary">Unavailable</span>
                }
            </td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@item.DoctorId">Details</a>
                <a asp-action="Edit" asp-route-id="@item.DoctorId">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.DoctorId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
